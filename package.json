{
  "name": "mime-types-lite-workspace",
  "version": "1.9.0",
  "private": true,
  "description": "mime-types-lite library and interactive documentation workspace.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter mime-types-lite build && pnpm --filter @mime-types-lite/web dev",
    "build": "pnpm --filter @mime-types-lite/web... build",
    "build:package": "pnpm --filter mime-types-lite build",
    "build:web": "pnpm --filter @mime-types-lite/web... build",
    "check": "pnpm check:package && pnpm --filter @mime-types-lite/web check",
    "check:package": "pnpm --filter mime-types-lite check",
    "check:web": "pnpm --filter mime-types-lite build && pnpm --filter @mime-types-lite/web check",
    "test": "pnpm --filter mime-types-lite test",
    "test:types": "pnpm --filter mime-types-lite test:types",
    "release:check": "pnpm --filter mime-types-lite release:check",
    "format": "pnpm --recursive --if-present format",
    "format:check": "pnpm --recursive --if-present format:check"
  },
  "keywords": [
    "mime",
    "mime-types",
    "media-type",
    "content-type",
    "typescript",
    "constants",
    "file-extension",
    "http",
    "uploads",
    "validation",
    "content-negotiation",
    "zero-dependency",
    "esm",
    "commonjs"
  ],
  "author": "Mohammad Montasim Al Mamun Shuvo <montasimmamun@gmail.com> (https://montasim-dev.web.app/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/mime-types-lite.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/mime-types-lite/issues"
  },
  "homepage": "https://mime-types-lite-demo.netlify.app",
  "packageManager": "pnpm@10.17.1"
}
