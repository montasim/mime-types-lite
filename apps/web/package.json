{
  "name": "@mime-types-lite/web",
  "version": "2.0.0",
  "description": "Official documentation, interactive examples, and API reference for mime-types-lite — zero-dependency, type-safe MIME constants and helpers.",
  "private": true,
  "type": "module",
  "keywords": [
    "mime",
    "mime-types",
    "media-type",
    "content-type",
    "file-extension",
    "typescript",
    "http",
    "uploads",
    "validation",
    "tanstack-start",
    "react",
    "documentation",
    "netlify"
  ],
  "author": {
    "name": "Mohammad Montasim Al Mamun Shuvo",
    "url": "https://github.com/montasim"
  },
  "license": "MIT",
  "homepage": "https://mime-types-lite-demo.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/mime-types-lite.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/montasim/mime-types-lite/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm generate-routes && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mime-types-lite": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
